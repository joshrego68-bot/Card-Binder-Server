# Railway sets DATABASE_URL automatically once you add a Postgres database
# service to this project — you don't need to fill this in yourself there.
DATABASE_URL=postgresql://user:password@host:port/database

# Set this yourself in Railway → your service → Variables.
# Use a long, random string (e.g. generate one with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# Railway sets PORT automatically — this is only used for local testing.
PORT=3000
